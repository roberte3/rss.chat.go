# Local configuration and runtime state.
# All three are generated by `go run . -setup`. config.json holds the SMTP
# password, so it must never be committed — see config.example.json.
config.json
settings.json
blocklist.json

# Databases
*.db
*.db-wal
*.db-shm

# Generated feed output and uploads
/feeds/
/temp_media/

# Compiled binaries (`go build` output; see Makefile)
/rss-chat
/backup
/restore
/reset
/testdata
/websocket-status
/tools/backup/backup
/tools/restore/restore
/tools/reset/reset
/tools/testdata/testdata
/tools/websocket-status/websocket-status

# Logs
*.log

# Local-only working directories
/archive/
/notes/
/.claude/

# macOS
.DS_Store
